<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest ApplicationTypeName="TravelPlannerAppType" ApplicationTypeVersion="1.0.0"
                      xmlns="http://schemas.microsoft.com/2011/01/fabric"
                      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="Identity.ServicePkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="TripPlanning.ServicePkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>
  <ServiceManifestImport>
    <ServiceManifestRef ServiceManifestName="Sharing.ServicePkg" ServiceManifestVersion="1.0.0" />
    <ConfigOverrides />
  </ServiceManifestImport>

  <DefaultServices>
    <Service Name="IdentityService" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="Identity.ServiceType" InstanceCount="1">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="TripPlanningService" ServicePackageActivationMode="ExclusiveProcess">
      <StatelessService ServiceTypeName="TripPlanning.ServiceType" InstanceCount="1">
        <SingletonPartition />
      </StatelessService>
    </Service>
    <Service Name="SharingService" ServicePackageActivationMode="ExclusiveProcess">
      <!-- TargetReplicaSetSize=1 for a 1-node local dev cluster; bump for a real multi-node cluster. -->
      <StatefulService ServiceTypeName="Sharing.ServiceType" TargetReplicaSetSize="1" MinReplicaSetSize="1">
        <SingletonPartition />
      </StatefulService>
    </Service>
  </DefaultServices>
</ApplicationManifest>
