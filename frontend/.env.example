# --- Backend service URLs ---
# Faza 1-N (lokalni razvoj, servisi pokrenuti pojedinačno preko `dotnet run`,
# BEZ Service Fabric klastera): svaki servis ima svoj port.
VITE_IDENTITY_API_URL=http://localhost:5101
VITE_TRIPPLANNING_API_URL=http://localhost:5102
VITE_SHARING_API_URL=http://localhost:5103

# Kada Service Fabric lokalni klaster bude pokrenut, ove tri se zamenjuju jednim
# URL-om ka ugrađenom SF Reverse Proxy-ju (vidi docs/architecture.md):
#   VITE_IDENTITY_API_URL=http://localhost:19081/TravelPlannerApp/IdentityService
#   VITE_TRIPPLANNING_API_URL=http://localhost:19081/TravelPlannerApp/TripPlanningService
#   VITE_SHARING_API_URL=http://localhost:19081/TravelPlannerApp/SharingService
